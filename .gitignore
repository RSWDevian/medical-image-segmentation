# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Dataset (never commit raw or processed data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*.zip

# Model checkpoints (large binaries, incl. experiment subfolders)
checkpoints/**/*.pth
checkpoints/**/*.pt
!checkpoints/.gitkeep

# Kaggle credentials must never be committed
kaggle.json
.kaggle/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log
